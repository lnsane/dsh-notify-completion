# Normalize line endings in the repository so a Windows checkout and a Linux
# checkout produce identical bytes. The shim is a PowerShell script; PowerShell
# accepts either ending, but pinning LF keeps every text file consistent and
# keeps `git status` quiet across platforms.

* text=auto eol=lf

# Windows-only script with no cross-platform meaning; store it exactly as
# authored rather than letting an editor rewrite it per platform.
*.ps1 text eol=lf

# Batch files must keep CRLF to run under cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets are never normalized.
*.png binary
*.jpg binary
*.ico binary
